{
  "name": "vectiscode",
  "version": "0.1.0-alpha.1",
  "description": "Local-first Roblox coding agent with native Studio MCP",
  "type": "module",
  "bin": {
    "vectiscode": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@napi-rs/keyring": "1.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "esbuild": "0.28.1",
    "tsx": "^4.23.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "keywords": [
    "roblox",
    "luau",
    "ai",
    "cli",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vectiscode/vectiscode-cli.git"
  }
}
