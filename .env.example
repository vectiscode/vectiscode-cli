NODE_ENV=development

# Local app URLs
WEB_APP_URL=https://vectiscode.com
API_BASE_URL=https://api.vectiscode.com
COOKIE_SECURE=false
ALLOW_PRIVATE_OWNER_LOGIN=true
ALLOW_LOCAL_FILE_STORE=true
PUBLIC_SIGNUPS_ENABLED=true
FREE_TIER_MODE=true
DURABLE_RATE_LIMITS=true
JSON_BODY_LIMIT=2mb
MAX_SNAPSHOTS_PER_PROJECT=2

# Local development can use JSON files. Production must use Supabase.
DATABASE_MODE=local
APPLY_DATABASE_SCHEMA_ON_STARTUP=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vectis-attachments

# Firebase login. This is the only Google-backed runtime feature.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Roblox OAuth is optional and separate from Roblox API keys.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=https://api.vectiscode.com/auth/roblox/callback
ROBLOX_OPEN_CLOUD_API_KEY=

# Admin
ADMIN_EMAILS=

# Non-Google AI providers
YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_PREFER=true
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
XIAOMI_API_KEY=

# Google Cloud / Vertex AI (Gemini models)
# Run 'gcloud auth application-default login' for local dev.
# For production, set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON key path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Stripe Billing. Never commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_STUDIO_ANNUAL_PRICE_ID=
STRIPE_TOP_UP_SMALL_PRICE_ID=
STRIPE_TOP_UP_LARGE_PRICE_ID=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
STRIPE_PRO_CURRENCY=usd
STRIPE_SUCCESS_URL=https://vectiscode.com/profile?billing=success
STRIPE_CANCEL_URL=https://vectiscode.com/profile?billing=cancelled
STRIPE_PORTAL_RETURN_URL=https://vectiscode.com/profile

# API deployment
HF_TOKEN=

# Web deployment (Cloudflare Pages)
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=vectiscode
CF_PAGES_BRANCH=main

# Web build envs (defaults to prod URLs if unset)
VITE_API_URL=https://api.vectiscode.com
VITE_WS_URL=wss://api.vectiscode.com/ws

# Post-deploy health check (defaults shown)
HEALTH_API_URL=https://api.vectiscode.com
HEALTH_WEB_URL=https://vectiscode.com
HEALTH_POLL_ATTEMPTS=12
HEALTH_POLL_INTERVAL_MS=5000

# Supabase operations only. Do not set these in the web app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_SUGGESTIONS_CHANNEL_ID=
DISCORD_CHANGELOG_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
