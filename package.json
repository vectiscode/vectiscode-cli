{
  "name": "vectiscode",
  "version": "0.1.0",
  "description": "Find out why your Claude Code and Codex limits drain, and what to change. Runs locally on your own logs.",
  "keywords": [
    "claude-code",
    "codex",
    "usage",
    "rate-limits",
    "tokens",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectiscode/vectiscode-cli.git"
  },
  "homepage": "https://github.com/vectiscode/vectiscode-cli#readme",
  "bugs": "https://github.com/vectiscode/vectiscode-cli/issues",
  "type": "module",
  "bin": {
    "vectiscode": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "doctor": "tsc && node dist/cli.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
